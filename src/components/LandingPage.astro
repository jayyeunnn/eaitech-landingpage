---
// S-001: urutan tujuh bagian frame 09 (LAYOUT bagian 0), sama untuk `/` dan `/id`.
import Shell from './Shell.astro';
import Hero from './sections/Hero.astro';
import Services from './sections/Services.astro';
import Project from './sections/Project.astro';
import Process from './sections/Process.astro';
import Faq from './sections/Faq.astro';
import Cta from './sections/Cta.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Shell lang={lang} page="home">
  <Hero lang={lang} />
  <Services lang={lang} />
  <Project lang={lang} />
  <Process lang={lang} />
  <Faq lang={lang} />
  <Cta lang={lang} />
</Shell>
