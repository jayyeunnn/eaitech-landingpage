---
// Satu tahap How It Works: titik di garis, nama dan satu kalimat di sampingnya.
// Tablet ke atas: teks bergantian kiri-kanan. HP: garis di kiri, teks di kanan.
interface Props {
  number: string;
  title: string;
  body: string;
  left: boolean;
  // Tahap terakhir: garis berhenti di titik ini.
  last?: boolean;
}

const { number, title, body, left, last = false } = Astro.props;
---

<li class="relative grid grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-x-4 tablet:grid-cols-[minmax(0,1fr)_6rem_minmax(0,1fr)] tablet:gap-x-0">
  {last && <span aria-hidden="true" class="absolute top-1/2 bottom-0 left-5 w-1 -translate-x-1/2 bg-light-bg tablet:left-1/2"></span>}
  <div class="col-start-1 row-start-1 flex justify-center tablet:col-start-2">
    <span data-flow-node class="relative z-10 flex size-10 items-center justify-center rounded-full border-[1.5px] border-route bg-white text-[0.75rem] text-accent-ink data-on:border-accent-ink data-on:bg-mint data-on:text-light-text">{number}</span>
  </div>
  <div data-flow-item class:list={['col-start-2 row-start-1', left ? 'tablet:col-start-1 tablet:text-right' : 'tablet:col-start-3']}>
    <h3 class="text-card font-normal tracking-[-0.02em]">{title}</h3>
    <p class="mt-1 text-small text-light-muted">{body}</p>
  </div>
</li>
