---
// Tombol pil (P-023). Hero dan kategori layanan memakai tombol tanpa panah
// sesuai frame 09 (revisi Jay 2026-11-06). Tanpa `href`, tombol tampil tetapi
// belum mengarah ke mana pun (halaman tujuan menyusul).
interface Props {
  href?: string;
  variant: 'solid' | 'mint' | 'text' | 'outline';
  external?: boolean;
  srSuffix?: string;
  class?: string;
  [key: `data-${string}`]: unknown;
}

const { href, variant, external = false, srSuffix, class: className, ...rest } = Astro.props;

const Tag = href ? 'a' : 'span';

const variants = {
  solid: 'h-13.5 px-8 bg-dark-bg text-dark-text font-semibold',
  mint: 'h-10.5 px-8 bg-mint text-light-text font-semibold',
  text: 'h-13.5 px-4 text-light-text font-medium underline-offset-4 hover:underline',
  outline: 'h-11 px-5 border border-route text-light-text font-medium',
};
---

<Tag
  href={href}
  data-press
  class:list={[
    'inline-flex shrink-0 items-center justify-center rounded-full text-button whitespace-nowrap',
    variants[variant],
    className,
  ]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  {...rest}
>
  <slot />
  {srSuffix && <span class="sr-only">&nbsp;{srSuffix}</span>}
</Tag>
