---
// 1. Hero (terang), frame 09 (revisi Jay 2026-11-06): judul serif di tengah,
// tombol WA dan tombol ke Project, HP di kiri dan laptop di kanan yang terpotong
// tepi. Gambar sudah miring dari FigCraft, jadi animasi hanya menambah selisih.
// Isi layar perangkat: screenshot demo sementara selama pengembangan, wajib
// diganti sebelum rilis (lihat SOURCES.md di folder FigCraft).
//
// Tiga lapis per perangkat agar animasi tidak saling menimpa:
// [data-hero-device] scroll > [data-hero-tilt] kursor > [data-hero-intro] masuk.
import { Image } from 'astro:assets';
import phone from '../../assets/design/hero-phone.png';
import laptop from '../../assets/design/hero-laptop.png';
import Button from '../Button.astro';
import PlaceholderTag from '../PlaceholderTag.astro';
import { content } from '../../i18n/content';
import { sectionIds, type Lang } from '../../i18n/ui';
import { waLink } from '../../config/whatsapp';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const ids = sectionIds[lang];
---

<section
  id={ids.hero}
  data-section="hero"
  data-mode="light"
  data-hero
  aria-labelledby="hero-title"
  class="relative h-svh min-h-160 overflow-hidden bg-light-bg text-light-text"
>
  <div
    data-hero-device="phone"
    class="absolute top-[max(56%,26rem)] left-[-22%] w-[66%] tablet:top-[50%] tablet:left-[-14%] tablet:w-[52%] desktop:top-[27.1%] desktop:left-[-14.49%] desktop:w-[40.94%]"
  >
    <div data-hero-tilt>
      <Image
        src={phone}
        alt=""
        data-hero-intro
        widths={[400, 600, 900, 1179]}
        sizes="(min-width: 75rem) 41vw, 60vw"
        loading="eager"
        class="h-auto w-full"
      />
    </div>
  </div>

  <div
    data-hero-device="laptop"
    class="absolute top-[max(58%,27rem)] left-[40%] w-[104%] tablet:top-[52%] tablet:left-[46%] tablet:w-[88%] desktop:top-[28.1%] desktop:left-[66.66%] desktop:w-[68.58%]"
  >
    <div data-hero-tilt>
      <Image
        src={laptop}
        alt=""
        data-hero-intro
        widths={[600, 900, 1400, 1975]}
        sizes="(min-width: 75rem) 69vw, 100vw"
        loading="eager"
        class="h-auto w-full"
      />
    </div>
  </div>

  <div class="relative z-10 mx-auto flex h-full max-w-content flex-col items-center px-4 pt-24 text-center tablet:pt-32 desktop:justify-center desktop:pt-[7svh]">
    <PlaceholderTag show={t.hero.placeholder} label={t.a11y.placeholderTag} />
    <h1 id="hero-title" class="font-serif text-hero font-normal">
      <span class="block">{t.hero.title[0]}</span>
      <span class="block">{t.hero.title[1]}</span>
    </h1>
    <p class="mt-4 max-w-155 text-body text-light-muted tablet:mt-6 desktop:mt-[5.5svh]">{t.hero.lead}</p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-2 desktop:mt-[4.5svh] desktop:gap-6">
      <Button href={waLink(lang)} variant="solid" external srSuffix={t.a11y.newTab}>{t.hero.discuss}</Button>
      <Button href={`#${ids.project}`} variant="text">{t.hero.work}</Button>
    </div>
  </div>
</section>
