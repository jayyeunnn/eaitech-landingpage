---
// 5. Ajakan WhatsApp (terang), revisi Jay 2026-10-30: adaptasi penutup Aperios
// (REF-003). Seluruh area adalah satu link ke WhatsApp: kalimat ajakan di kiri
// atas, panah garis raksasa di kanan, lalu judul raksasa tebal di dekat batas
// footer (dinaikkan sedikit dari batas, arahan Jay 2026-10-30). Revisi
// 2026-10-30: isi dipojokkan (melebar ke tepi) dan ruang atas-bawah dipersempit.
import Section from '../Section.astro';
import PlaceholderTag from '../PlaceholderTag.astro';
import { content } from '../../i18n/content';
import { sectionIds, type Lang } from '../../i18n/ui';
import { waLink } from '../../config/whatsapp';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<Section id={sectionIds[lang].contact} sectionKey="contact" mode="light" labelledby="cta-title" frame={false} class="pt-8! pb-0! tablet:pt-10! desktop:pt-10!">
  <a href={waLink(lang)} target="_blank" rel="noopener noreferrer" class="group/cta block">
    <span class="sr-only">{t.cta.button} {t.a11y.newTab}. </span>
    <div class="flex items-start justify-between gap-8">
      <div data-reveal>
        <PlaceholderTag show={t.cta.placeholder} label={t.a11y.placeholderTag} class="mb-6 text-light-muted" />
        <p class="max-w-[24ch] text-subhead font-light text-balance">{t.cta.title}</p>
      </div>
      <svg
        viewBox="0 0 100 100"
        class="size-16 shrink-0 text-light-text transition-transform duration-[var(--dur-base)] ease-brand group-hover/cta:translate-x-2 group-hover/cta:-translate-y-2 tablet:size-24 desktop:size-32"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M8 92 L92 8 M30 8 H92 V70" vector-effect="non-scaling-stroke" />
      </svg>
    </div>

    <div class="mt-16 pb-8 tablet:mt-20 tablet:pb-10 desktop:mt-24 desktop:pb-12">
      {/*
        Hover/fokus (arahan Jay 2026-10-30): kotak hijau tua (warna latar bagian
        gelap) masuk dari kiri menutupi judul, lalu teks tebal putih "Via
        WhatsApp" muncul dan mengisi lebar kotak (ukuran dari container query).
        Di layar sentuh tidak ada hover; judul tetap tampil biasa.
      */}
      <h2 id="cta-title" class="relative inline-block text-display leading-none! font-bold text-light-text">
        {t.cta.big}
        <span
          aria-hidden="true"
          class="@container absolute -inset-x-3 -top-[0.04em] -bottom-[0.24em] flex origin-left scale-x-0 items-center overflow-hidden bg-dark-bg px-3 transition-transform duration-[var(--dur-base)] ease-brand group-hover/cta:scale-x-100 group-focus-visible/cta:scale-x-100"
        >
          <span class="text-[14cqw] leading-none font-bold whitespace-nowrap text-dark-text opacity-0 transition-opacity duration-[var(--dur-fast)] ease-brand group-hover/cta:opacity-100 group-hover/cta:delay-150 group-focus-visible/cta:opacity-100">
            {t.cta.via}
          </span>
        </span>
      </h2>
    </div>
  </a>
</Section>
