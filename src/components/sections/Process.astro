---
// 3. Cara Kerja (terang), revisi Jay 2026-10-30: dengan JS dan gerak normal,
// bagian ini memenuhi layar dan menempel; cincin titik di kiri terisi halus
// mengikuti scroll (4 tahap), nomor dan teks langkah di kanan berganti 01 → 04
// (process-scroll.ts, Motion). HP: cincin di atas, teks di bawah. Revisi
// 2026-10-30: semua elemen diperbesar, judul besar tebal, isi melebar ke tepi.
// Tanpa JS atau dengan reduced motion: daftar empat langkah biasa (fallback).
// Isi langkah masih placeholder (P-008).
import SectionHeading from '../SectionHeading.astro';
import DotArt from '../DotArt.astro';
import { content } from '../../i18n/content';
import { sectionIds, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const p = t.process;
const total = p.steps.length;
const pad = (n: number) => String(n).padStart(2, '0');

// Cincin progres: titik di lingkaran (penanda tahap dihapus, arahan Jay 2026-10-30).
const RING_DOTS = 64;
const ring = Array.from({ length: RING_DOTS }, (_, i) => {
  const a = (i / RING_DOTS) * Math.PI * 2 - Math.PI / 2;
  return { cx: (60 + Math.cos(a) * 46).toFixed(2), cy: (60 + Math.sin(a) * 46).toFixed(2) };
});
---

<section
  id={sectionIds[lang].process}
  data-section="process"
  data-mode="light"
  data-process
  aria-labelledby="process-title"
  class="group/proc bg-light-bg text-light-text"
>
  <div data-process-pin>
    {/* Fallback: daftar langkah biasa. Disembunyikan saat mode menempel aktif. */}
    <div class="mx-auto max-w-content px-4 py-20 pinned:hidden tablet:px-8 tablet:py-24 desktop:px-10 desktop:py-32">
      <SectionHeading id="process-title" lines={p.title} placeholder={p.placeholder} placeholderLabel={t.a11y.placeholderTag} />
      <ol class="mt-12 grid gap-x-8 tablet:grid-cols-2 desktop:mt-16 desktop:grid-cols-4 desktop:gap-x-0">
        {
          p.steps.map((step, i) => (
            <li data-reveal data-reveal-delay={(i * 0.08).toFixed(2)} class="border-t border-light-line py-8 desktop:border-t-0 desktop:border-l desktop:px-6 desktop:py-0 desktop:first:border-l-0 desktop:first:pl-0">
              <DotArt step={i + 1} total={total} />
              <p class="mt-6 text-label font-medium text-light-muted">{pad(i + 1)}</p>
              <h3 class="mt-2 text-title font-normal">{step.title}</h3>
              <p class="mt-3 text-body text-light-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>

    {/* Mode menempel: layar penuh, cincin kiri, teks kanan. */}
    <div
      data-process-stage
      class="hidden pinned:sticky pinned:top-0 pinned:flex pinned:h-svh pinned:items-center"
    >
      <div
        data-process-panel
        data-steps={JSON.stringify(p.steps)}
        class="mx-auto grid w-full max-w-content items-center gap-8 px-4 tablet:px-8 desktop:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] desktop:gap-20 desktop:px-10"
      >
        <div class="relative mx-auto w-56 tablet:w-80 desktop:w-full desktop:max-w-[38rem]" aria-hidden="true">
          <svg viewBox="0 0 120 120" class="size-full" focusable="false">
            {ring.map((d) => <circle data-ring-dot cx={d.cx} cy={d.cy} r="1.9" class="fill-light-line" />)}
          </svg>
          <span data-ring-number class="absolute inset-0 flex items-center justify-center text-hero font-light">1</span>
        </div>

        <div>
          {/* Judul besar tebal, sama dengan Services dan FAQ (revisi Jay 2026-10-30). */}
          <SectionHeading lines={p.title} placeholder={p.placeholder} placeholderLabel={t.a11y.placeholderTag} />
          <div data-step-text aria-live="polite" class="mt-6 desktop:mt-10">
            {/* Nomor tanpa nol di depan dan tanpa "/ 4" (arahan Jay 2026-10-30). */}
            <p data-step-number class="text-numeral font-light">1</p>
            <h3 data-step-title class="mt-3 text-section font-light text-balance">{p.steps[0].title}</h3>
            <p data-step-body class="mt-4 max-w-prose text-lead text-light-muted">{p.steps[0].body}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
