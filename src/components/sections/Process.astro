---
// 4. How It Works (terang), revisi Jay 2026-11-06: diagram alur yang disederhanakan.
// Lima tahap di garis tengah, teks bergantian kiri-kanan, cabang empat layanan
// berupa pil kecil setelah Plan. Garis tergambar mengikuti scroll, titik menyala dan
// teks muncul saat garis sampai (src/scripts/process-scroll.ts). Tanpa JS/reduced
// motion: alur tampil utuh. HP: garis di kiri, pil 2 x 2.
import ProcessStage from '../ProcessStage.astro';
import PlaceholderTag from '../PlaceholderTag.astro';
import { content } from '../../i18n/content';
import { sectionIds, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const p = t.process;
const number = (i: number) => String(i + 1).padStart(2, '0');
// Satu garis tahap: dua bagian dipisah cabang kategori setelah Plan.
const before = p.stages.slice(0, 2).map((stage, i) => ({ stage, i }));
const after = p.stages.slice(2).map((stage, i) => ({ stage, i: i + 2 }));
// Posisi tengah pil di cabang, dalam skala 1040 x 160.
const columns = [124, 388, 652, 916];
const lineClass = 'absolute inset-y-0 left-5 w-0.5 -translate-x-1/2 bg-route';
const barClass = 'absolute inset-0 origin-top bg-accent-ink pinned:scale-y-0';
const pathProps = { pathLength: '1', 'stroke-width': '2', 'vector-effect': 'non-scaling-stroke' };
---

<section
  id={sectionIds[lang].process}
  data-section="process"
  data-mode="light"
  aria-labelledby="process-title"
  class="bg-light-bg text-light-text"
>
  <div class="mx-auto max-w-content px-4 pt-16 pb-24 tablet:px-8 desktop:px-10">
    <PlaceholderTag show={p.placeholder} label={t.a11y.placeholderTag} />
    <h2 data-reveal id="process-title" class="text-center font-serif text-display font-normal">{p.title}</h2>

    <div data-flow class="relative mx-auto mt-14 max-w-flow desktop:mt-16">
      <div class="relative">
        <span data-flow-line class:list={[lineClass, 'tablet:left-1/2']}><span data-flow-bar class={barClass}></span></span>
        <ol class="grid gap-12 pt-6 pb-10 tablet:gap-16">
          {before.map(({ stage, i }) => <ProcessStage number={number(i)} title={stage.title} body={stage.body} left={i % 2 === 0} />)}
        </ol>
      </div>

      <div data-flow-branch class="relative">
        {/* HP: garis lurus melewati kategori. Tablet ke atas: garis bercabang. */}
        <span data-flow-line class:list={[lineClass, 'tablet:hidden']}><span data-flow-bar class={barClass}></span></span>
        <svg viewBox="0 0 1040 160" preserveAspectRatio="none" fill="none" aria-hidden="true" class="absolute inset-0 hidden size-full tablet:block">
          {columns.map((x) => (
            <Fragment>
              <path d={`M520 0 C520 36 ${x} 22 ${x} 58`} class="stroke-route" {...pathProps} />
              <path d={`M${x} 102 C${x} 138 520 124 520 160`} class="stroke-route" {...pathProps} />
              <path data-branch-in d={`M520 0 C520 36 ${x} 22 ${x} 58`} class="stroke-accent-ink pinned:[stroke-dasharray:1_2] pinned:[stroke-dashoffset:1]" {...pathProps} />
              <path data-branch-out d={`M${x} 102 C${x} 138 520 124 520 160`} class="stroke-accent-ink pinned:[stroke-dasharray:1_2] pinned:[stroke-dashoffset:1]" {...pathProps} />
            </Fragment>
          ))}
        </svg>
        <div class="relative pl-14 tablet:flex tablet:h-40 tablet:items-center tablet:pl-0">
          <ul class="grid w-full grid-cols-2 gap-2 tablet:grid-cols-4 tablet:gap-4">
            {t.services.items.map((item) => (
              <li data-flow-item class="flex min-h-11 items-center justify-center rounded-full border border-light-line bg-white px-3 py-2 text-center text-[0.8125rem] leading-tight">{item.name}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="relative">
        <span data-flow-line class:list={[lineClass, 'tablet:left-1/2']}><span data-flow-bar class={barClass}></span></span>
        <ol start="3" class="grid gap-12 pt-10 tablet:gap-16">
          {after.map(({ stage, i }) => <ProcessStage number={number(i)} title={stage.title} body={stage.body} left={i % 2 === 0} last={i === p.stages.length - 1} />)}
        </ol>
      </div>
    </div>
  </div>
</section>
