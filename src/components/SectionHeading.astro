---
// Judul FAQ: dua baris kapital Instrument Serif (frame 09, revisi Jay 2026-11-06).
import PlaceholderTag from './PlaceholderTag.astro';

interface Props {
  id?: string;
  lines: [string, string];
  placeholder: boolean;
  placeholderLabel: string;
  class?: string;
}

const { id, lines, placeholder, placeholderLabel, class: className } = Astro.props;
---

<div data-reveal class={className}>
  <PlaceholderTag show={placeholder} label={placeholderLabel} />
  <h2 id={id} class="font-serif text-display-lg font-normal uppercase">
    <span class="block">{lines[0]}</span>
    <span class="block">{lines[1]}</span>
  </h2>
</div>
